# ==================================
# ENVIRONMENT VARIABLES TEMPLATE - ADMIN PANEL
# ==================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to Git!
# ==================================

# ==================================
# OPENROUTER API (Optional for admin stats)
# ==================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==================================
# FIREBASE CONFIGURATION
# ==================================
# Get these from Firebase Console:
# https://console.firebase.google.com/project/YOUR_PROJECT_ID/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ==================================
# ADMIN PANEL PORT (Development only)
# ==================================
NEXT_PUBLIC_ADMIN_PORT=3001
